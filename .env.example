# Application
APP_NAME=EGO Marketplace API
# ENV is informational only (no code branches on it yet) - it's a label for
# whoever's reading the deployed environment's config, not a behavior switch.
ENV=development
# DEBUG=true is a LOCAL-DEV-ONLY convenience: FastAPI/Starlette's debug mode
# bypasses this app's own exception handlers for unhandled exceptions and
# returns a raw traceback in the HTTP response instead of the app's generic
# "Internal server error" - see docs/mvp-backend-audit.md. MUST be `false`
# in every deployed environment (staging, production) - never deploy with
# DEBUG=true.
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
# DEBUG/INFO/WARNING/ERROR (see docs/mvp-backend-audit.md's Logging section
# for what's logged at each level). Never set to a level that would need
# secrets in the log line to be useful - the app never logs the
# Authorization header, Firebase tokens, passwords, or DB credentials at
# any level, by design (app/core/request_logging.py, app/auth/dependencies.py).
LOG_LEVEL=INFO

# CORS - comma-separated list of allowed origins. In production this must
# be the real deployed frontend origin(s) only - never "*" (FastAPI/Starlette
# also rejects "*" combined with allow_credentials=True, which this app
# uses). See docs/mvp-backend-audit.md's CORS section.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
# Get this from the Supabase dashboard: Project Settings > Database >
# Connection string > URI. Never commit the real value.
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ego

# Supabase requires SSL on external connections - keep true for Supabase,
# set false only when pointing at a local/non-TLS Postgres for development.
DB_SSL_REQUIRE=true

# "session" for a direct connection or Supavisor session pooler (port 5432).
# "transaction" for the Supavisor transaction pooler (port 6543).
DB_POOL_MODE=session

# SQLAlchemy pool sizing (only used when DB_POOL_MODE=session)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

DB_ECHO=false

# --- Firebase Admin SDK (server-side ID token verification only) ---
# Set exactly ONE of these. Get the service-account JSON from Firebase
# Console > Project Settings > Service accounts > Generate new private key.
# NEVER commit the real file/value - see .gitignore and docs/authentication.md.
#
# Option A - paste the full service-account JSON as a single-line string
# (typical for hosting platforms where you set secrets as env vars):
FIREBASE_CREDENTIALS_JSON=

# Option B - path to a local service-account JSON file (local dev only):
FIREBASE_CREDENTIALS_FILE=
